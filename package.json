{
  "name": "@danielsimonjr/math-mcp",
  "version": "3.4.0",
  "description": "MCP server for mathematical computations with WASM acceleration - up to 42x faster, with comprehensive input validation, security features, rate limiting, and expression caching",
  "main": "dist/index-wasm.js",
  "scripts": {
    "test": "node test/integration-test.js",
    "test:correctness": "node test/correctness-tests.js",
    "test:all": "npm test && npm run test:correctness",
    "test:unit": "vitest",
    "test:coverage": "vitest --coverage",
    "test:security": "vitest run test/security/",
    "build": "tsc",
    "build:wasm": "cd wasm && npm run asbuild",
    "build:all": "npm run build && npm run build:wasm",
    "build:verify": "npm run verify:dist && npm run verify:wasm && npm run verify:hashes",
    "verify:dist": "test -d dist && test -f dist/index-wasm.js || (echo 'Error: dist/ directory missing or incomplete' && exit 1)",
    "verify:wasm": "test -f wasm/build/release.wasm && test -f wasm/build/debug.wasm || (echo 'Error: WASM modules not built' && exit 1)",
    "verify:hashes": "test -f wasm-hashes.json || (echo 'Error: wasm-hashes.json missing' && exit 1)",
    "generate:hashes": "node scripts/generate-wasm-hashes.js",
    "check:deps": "node scripts/check-dependencies.js",
    "start": "node dist/index-wasm.js",
    "dev": "tsc && node dist/index-wasm.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky install",
    "prepublishOnly": "npm run type-check && npm run build:all && npm run generate:hashes && npm test && npm run build:verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mathjs",
    "mathematics",
    "calculator",
    "wasm",
    "webassembly",
    "performance",
    "statistics",
    "linear-algebra",
    "matrix",
    "calculus"
  ],
  "author": "math-mcp contributors",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/math-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/math-mcp/issues"
  },
  "homepage": "https://github.com/danielsimonjr/math-mcp#readme",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.2",
    "mathjs": "15.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "1.6.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jsdoc": "48.2.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "1.6.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "bin": {
    "math-mcp": "./dist/index-wasm.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
